# Absolute path to your career-ops checkout (used only by the Vite dev server
# to expose GET /api/career-ops/applications). Loaded via loadEnv in vite.config;
# not bundled into the client.
CAREER_OPS_PATH=/Users/you/Documents/Programming/career-ops

# Absolute path to the folder of interview-prep markdown files (Live pack tab).
# Used only by the Vite dev server. You can also paste a path in the UI.
INTERVIEW_PREP_PATH=/Users/you/Documents/interview-prep
